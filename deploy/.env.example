# Copy to deploy/.env on the server and fill in. Never commit the real file.

# The web address, pointed at this server's IP with a DNS "A" record.
DOMAIN=krisimandi.example.com

# Make each of these a long random string, e.g. the output of: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=
OTP_SECRET=

# Real SMS through Sparrow SMS (https://sparrowsms.com). The token is in the Sparrow dashboard;
# FROM is the sender name Sparrow has approved for your account.
SMS_PROVIDER=sparrow
SPARROW_SMS_TOKEN=
SPARROW_SMS_FROM=

# Slack or Discord incoming webhook that receives error alerts. Optional but recommended.
ALERT_WEBHOOK_URL=
SITE_NAME=pilot

# Shown in the footer so people can call for help, e.g. 98XXXXXXXX. Needs a rebuild of the web app to change.
NEXT_PUBLIC_SUPPORT_PHONE=

# How many days of daily backups to keep on the server.
BACKUP_KEEP_DAYS=14
