# Caddy gets and renews the HTTPS certificate for DOMAIN automatically.
{$DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	# The API lives under /api; the prefix is removed before it reaches the API.
	handle_path /api/* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}
