// KrisiMandi database schema (PostgreSQL + PostGIS).
// Mirrors the ERD in the "KrisiMandi Web App Plan" doc.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------- Enums ----------

enum Role {
  FARMER
  BUYER
  ADMIN
}

enum Language {
  ne
  en
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DocType {
  CITIZENSHIP
  PAN
  OTHER
}

enum SaleMode {
  FIXED
  AUCTION
}

enum ListingStatus {
  DRAFT
  ACTIVE
  PAUSED
  SOLD
  EXPIRED
  REMOVED
}

enum OfferStatus {
  OPEN
  COUNTERED
  ACCEPTED
  REJECTED
  EXPIRED
  WITHDRAWN
}

enum AuctionStatus {
  SCHEDULED
  LIVE
  AWAITING_CONFIRMATION
  CLOSED
  NO_SALE
}

// A deal with no order record counts as cancelled (decision 2026-10-18).
enum OrderStatus {
  CONFIRMED
  READY_FOR_PICKUP
  PICKED_UP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum ComplaintTarget {
  USER
  LISTING
  ORDER
}

enum ComplaintStatus {
  OPEN
  FOLLOWING_UP
  CLOSED
}

enum NotificationChannel {
  IN_APP
  SMS
}

// ---------- Locations (Province > District > Municipality > Ward) ----------

model Province {
  id        Int        @id
  nameEn    String     @map("name_en")
  nameNe    String     @map("name_ne")
  districts District[]

  @@map("provinces")
}

model District {
  id             Int            @id
  provinceId     Int            @map("province_id")
  nameEn         String         @map("name_en")
  nameNe         String         @map("name_ne")
  province       Province       @relation(fields: [provinceId], references: [id])
  municipalities Municipality[]

  @@map("districts")
}

model Municipality {
  id         Int         @id
  districtId Int         @map("district_id")
  nameEn     String      @map("name_en")
  nameNe     String      @map("name_ne")
  type       String // metropolitan, sub-metropolitan, municipality, rural municipality
  district   District    @relation(fields: [districtId], references: [id])
  wards      Ward[]
  cropAlerts CropAlert[]

  @@map("municipalities")
}

model Ward {
  id             Int          @id @default(autoincrement())
  municipalityId Int          @map("municipality_id")
  wardNo         Int          @map("ward_no")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  users          User[]
  listings       Listing[]

  @@unique([municipalityId, wardNo])
  @@map("wards")
}

// ---------- Users ----------

model User {
  id                String            @id @default(uuid()) @db.Uuid
  phone             String            @unique // E.164, e.g. +97798XXXXXXXX
  fullName          String            @map("full_name")
  photoUrl          String?           @map("photo_url")
  roles             Role[]
  preferredLang     Language          @default(ne) @map("preferred_lang")
  wardId            Int?              @map("ward_id")
  village           String? // village or tole, e.g. Nawalpur
  isVerified        Boolean           @default(false) @map("is_verified")
  isSuspended       Boolean           @default(false) @map("is_suspended")
  createdAt         DateTime          @default(now()) @map("created_at")
  updatedAt         DateTime          @updatedAt @map("updated_at")
  ward              Ward?             @relation(fields: [wardId], references: [id])
  verificationDocs  VerificationDoc[] @relation("DocOwner")
  reviewedDocs      VerificationDoc[] @relation("DocReviewer")
  listings          Listing[]
  offers            Offer[]
  bids              Bid[]
  farmerConvos      Conversation[]    @relation("ConvoFarmer")
  buyerConvos       Conversation[]    @relation("ConvoBuyer")
  messages          Message[]
  buyerOrders       Order[]           @relation("OrderBuyer")
  farmerOrders      Order[]           @relation("OrderFarmer")
  reviewsGiven      Review[]          @relation("Reviewer")
  reviewsReceived   Review[]          @relation("Reviewee")
  complaintsFiled   Complaint[]       @relation("ComplaintFiler")
  complaintsHandled Complaint[]       @relation("ComplaintHandler")
  savedListings     SavedListing[]
  cropAlerts        CropAlert[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  refreshTokens     RefreshToken[]

  @@map("users")
}

model VerificationDoc {
  id         String             @id @default(uuid()) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  docType    DocType            @map("doc_type")
  fileUrl    String             @map("file_url")
  status     VerificationStatus @default(PENDING)
  reviewedBy String?            @map("reviewed_by") @db.Uuid
  reviewedAt DateTime?          @map("reviewed_at")
  createdAt  DateTime           @default(now()) @map("created_at")
  user       User               @relation("DocOwner", fields: [userId], references: [id])
  reviewer   User?              @relation("DocReviewer", fields: [reviewedBy], references: [id])

  @@map("verification_docs")
}

// ---------- Sign-in ----------

// One-time codes sent by SMS. Only a hash of the code is stored.
model OtpCode {
  id         String    @id @default(uuid()) @db.Uuid
  phone      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt])
  @@map("otp_codes")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------- Catalogue ----------

model Unit {
  id           Int       @id @default(autoincrement())
  code         String    @unique // kg, quintal, crate, piece, dozen
  nameEn       String    @map("name_en")
  nameNe       String    @map("name_ne")
  kgEquivalent Decimal?  @map("kg_equivalent") @db.Decimal(10, 3)
  crops        Crop[]
  listings     Listing[]

  @@map("units")
}

model Crop {
  id            Int         @id @default(autoincrement())
  nameEn        String      @map("name_en")
  nameNe        String      @map("name_ne")
  category      String // vegetable, fruit, grain, pulse, spice, other
  defaultUnitId Int         @map("default_unit_id")
  defaultUnit   Unit        @relation(fields: [defaultUnitId], references: [id])
  listings      Listing[]
  alerts        CropAlert[]

  @@unique([nameEn])
  @@map("crops")
}

// ---------- Listings ----------

model Listing {
  id             String                                 @id @default(uuid()) @db.Uuid
  farmerId       String                                 @map("farmer_id") @db.Uuid
  cropId         Int                                    @map("crop_id")
  variety        String?
  grade          String?
  description    String?
  quantity       Decimal                                @db.Decimal(12, 2)
  quantityLeft   Decimal                                @map("quantity_left") @db.Decimal(12, 2)
  unitId         Int                                    @map("unit_id")
  pricePerUnit   Decimal?                               @map("price_per_unit") @db.Decimal(12, 2) // NPR, FIXED mode only
  saleMode       SaleMode                               @map("sale_mode")
  harvestDate    DateTime                               @map("harvest_date") @db.Date
  availableUntil DateTime                               @map("available_until") @db.Date
  wardId         Int                                    @map("ward_id")
  village        String? // village or tole shown to buyers, e.g. Nawalpur
  // Exact pickup point; only shown to the other party once an order exists.
  location       Unsupported("geography(Point, 4326)")?
  status         ListingStatus                          @default(ACTIVE)
  createdAt      DateTime                               @default(now()) @map("created_at")
  updatedAt      DateTime                               @updatedAt @map("updated_at")
  farmer         User                                   @relation(fields: [farmerId], references: [id])
  crop           Crop                                   @relation(fields: [cropId], references: [id])
  unit           Unit                                   @relation(fields: [unitId], references: [id])
  ward           Ward                                   @relation(fields: [wardId], references: [id])
  photos         ListingPhoto[]
  offers         Offer[]
  auction        Auction?
  conversations  Conversation[]
  orders         Order[]
  savedBy        SavedListing[]

  @@index([status, cropId])
  @@index([wardId])
  @@index([farmerId])
  @@map("listings")
}

model ListingPhoto {
  id        String  @id @default(uuid()) @db.Uuid
  listingId String  @map("listing_id") @db.Uuid
  url       String
  sortOrder Int     @default(0) @map("sort_order")
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@map("listing_photos")
}

model SavedListing {
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("saved_listings")
}

// A buyer asks to hear about new listings of a crop, optionally in one municipality and
// at or under a price (the fixed price, or an auction's start price).
model CropAlert {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  cropId         Int           @map("crop_id")
  municipalityId Int?          @map("municipality_id")
  maxPrice       Decimal?      @map("max_price") @db.Decimal(12, 2)
  createdAt      DateTime      @default(now()) @map("created_at")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  crop           Crop          @relation(fields: [cropId], references: [id])
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])

  @@index([cropId])
  @@index([userId])
  @@map("crop_alerts")
}

// ---------- Offers (FIXED mode) ----------

model Offer {
  id            String      @id @default(uuid()) @db.Uuid
  listingId     String      @map("listing_id") @db.Uuid
  buyerId       String      @map("buyer_id") @db.Uuid
  pricePerUnit  Decimal     @map("price_per_unit") @db.Decimal(12, 2)
  quantity      Decimal     @db.Decimal(12, 2)
  pickupDate    DateTime    @map("pickup_date") @db.Date
  parentOfferId String?     @map("parent_offer_id") @db.Uuid // set on counter-offers
  madeByFarmer  Boolean     @default(false) @map("made_by_farmer") // true for a farmer's counter
  status        OfferStatus @default(OPEN)
  expiresAt     DateTime    @map("expires_at") // default 48 h after creation
  createdAt     DateTime    @default(now()) @map("created_at")
  listing       Listing     @relation(fields: [listingId], references: [id])
  buyer         User        @relation(fields: [buyerId], references: [id])
  parentOffer   Offer?      @relation("CounterOffers", fields: [parentOfferId], references: [id])
  counters      Offer[]     @relation("CounterOffers")
  order         Order?

  @@index([listingId, status])
  @@map("offers")
}

// ---------- Auctions (AUCTION mode) ----------

model Auction {
  id           String        @id @default(uuid()) @db.Uuid
  listingId    String        @unique @map("listing_id") @db.Uuid
  startPrice   Decimal       @map("start_price") @db.Decimal(12, 2) // per unit, NPR
  reservePrice Decimal?      @map("reserve_price") @db.Decimal(12, 2)
  minIncrement Decimal       @map("min_increment") @db.Decimal(12, 2)
  startsAt     DateTime      @map("starts_at")
  endsAt       DateTime      @map("ends_at") // extended 5 min by a bid in the last 5 min
  status       AuctionStatus @default(SCHEDULED)
  winningBidId String?       @unique @map("winning_bid_id") @db.Uuid
  confirmBy    DateTime?     @map("confirm_by") // farmer confirms within 24 h of close
  listing      Listing       @relation(fields: [listingId], references: [id])
  bids         Bid[]         @relation("AuctionBids")
  winningBid   Bid?          @relation("WinningBid", fields: [winningBidId], references: [id])

  @@index([status, endsAt])
  @@map("auctions")
}

model Bid {
  id            String   @id @default(uuid()) @db.Uuid
  auctionId     String   @map("auction_id") @db.Uuid
  buyerId       String   @map("buyer_id") @db.Uuid
  amountPerUnit Decimal  @map("amount_per_unit") @db.Decimal(12, 2)
  placedAt      DateTime @default(now()) @map("placed_at")
  auction       Auction  @relation("AuctionBids", fields: [auctionId], references: [id])
  buyer         User     @relation(fields: [buyerId], references: [id])
  wonAuction    Auction? @relation("WinningBid")
  order         Order?

  @@index([auctionId, amountPerUnit(sort: Desc)])
  @@map("bids")
}

// ---------- Chat ----------

model Conversation {
  id        String    @id @default(uuid()) @db.Uuid
  listingId String    @map("listing_id") @db.Uuid
  farmerId  String    @map("farmer_id") @db.Uuid
  buyerId   String    @map("buyer_id") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  listing   Listing   @relation(fields: [listingId], references: [id])
  farmer    User      @relation("ConvoFarmer", fields: [farmerId], references: [id])
  buyer     User      @relation("ConvoBuyer", fields: [buyerId], references: [id])
  messages  Message[]

  @@unique([listingId, buyerId])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @map("conversation_id") @db.Uuid
  senderId       String       @map("sender_id") @db.Uuid
  body           String?
  photoUrl       String?      @map("photo_url")
  readAt         DateTime?    @map("read_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ---------- Orders and trust ----------

// Every deal goes through an order: from an accepted offer OR a winning bid.
model Order {
  id            String         @id @default(uuid()) @db.Uuid
  listingId     String         @map("listing_id") @db.Uuid
  buyerId       String         @map("buyer_id") @db.Uuid
  farmerId      String         @map("farmer_id") @db.Uuid
  offerId       String?        @unique @map("offer_id") @db.Uuid
  bidId         String?        @unique @map("bid_id") @db.Uuid
  pricePerUnit  Decimal        @map("price_per_unit") @db.Decimal(12, 2)
  quantity      Decimal        @db.Decimal(12, 2)
  pickupAt      DateTime?      @map("pickup_at")
  pickupPlace   String?        @map("pickup_place")
  paymentMethod PaymentMethod? @map("payment_method")
  paidStatus    PaymentStatus  @default(UNPAID) @map("paid_status")
  status        OrderStatus    @default(CONFIRMED)
  cancelReason  String?        @map("cancel_reason")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  listing       Listing        @relation(fields: [listingId], references: [id])
  buyer         User           @relation("OrderBuyer", fields: [buyerId], references: [id])
  farmer        User           @relation("OrderFarmer", fields: [farmerId], references: [id])
  offer         Offer?         @relation(fields: [offerId], references: [id])
  bid           Bid?           @relation(fields: [bidId], references: [id])
  reviews       Review[]

  @@index([buyerId, status])
  @@index([farmerId, status])
  @@map("orders")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  orderId    String   @map("order_id") @db.Uuid
  reviewerId String   @map("reviewer_id") @db.Uuid
  revieweeId String   @map("reviewee_id") @db.Uuid
  rating     Int // 1 to 5
  comment    String?
  createdAt  DateTime @default(now()) @map("created_at")
  order      Order    @relation(fields: [orderId], references: [id])
  reviewer   User     @relation("Reviewer", fields: [reviewerId], references: [id])
  reviewee   User     @relation("Reviewee", fields: [revieweeId], references: [id])

  @@unique([orderId, reviewerId])
  @@map("reviews")
}

// Parties settle disputes themselves; a complaint asks an admin to follow up.
model Complaint {
  id          String          @id @default(uuid()) @db.Uuid
  filedById   String          @map("filed_by_id") @db.Uuid
  targetType  ComplaintTarget @map("target_type")
  targetId    String          @map("target_id") @db.Uuid
  reason      String
  status      ComplaintStatus @default(OPEN)
  handledById String?         @map("handled_by_id") @db.Uuid
  adminNotes  String?         @map("admin_notes")
  createdAt   DateTime        @default(now()) @map("created_at")
  closedAt    DateTime?       @map("closed_at")
  filedBy     User            @relation("ComplaintFiler", fields: [filedById], references: [id])
  handledBy   User?           @relation("ComplaintHandler", fields: [handledById], references: [id])

  @@index([status])
  @@map("complaints")
}

// ---------- Notifications and audit ----------

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @map("user_id") @db.Uuid
  type      String // OFFER_RECEIVED, OUTBID, AUCTION_WON, ORDER_STATUS, ...
  data      Json
  channel   NotificationChannel
  readAt    DateTime?           @map("read_at")
  createdAt DateTime            @default(now()) @map("created_at")
  user      User                @relation(fields: [userId], references: [id])

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  actorId   String?  @map("actor_id") @db.Uuid
  action    String // BID_PLACED, ORDER_STATUS_CHANGED, USER_SUSPENDED, ...
  entity    String
  entityId  String   @map("entity_id")
  before    Json?
  after     Json?
  createdAt DateTime @default(now()) @map("created_at")
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
